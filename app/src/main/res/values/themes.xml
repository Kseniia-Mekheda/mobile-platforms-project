<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TASKFORGE" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/ui_accent_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ui_accent_secondary</item>
        <item name="colorOnSecondary">@color/ui_heading_text</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ui_body_text</item>
        <item name="colorOnSurfaceVariant">@color/ui_hint_text</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.TaskForge.Headline1</item>
