        <item name="materialButtonStyle">@style/Widget.TaskForge.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.TaskForge.CardView</item>
        <item name="floatingActionButtonStyle">@style/Widget.TaskForge.FAB</item>
        <item name="textInputStyle">@style/Widget.TaskForge.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.TaskForge.EditText</item>
        <item name="bottomNavigationStyle">@style/Widget.TaskForge.BottomNavigationView</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TaskForge.MaterialAlertDialog</item>
    </style>

    <style name="Theme.TASKFORGE" parent="Base.Theme.TASKFORGE" />
</resources>